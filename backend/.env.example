SKINS_DEV=1
# CHARACTER_UI_DEV=1
# PS_PRODUCTION=1
PLUGIN_KEY=dev-plugin-key
# Extra keys for non-primary servers (dev, tutorial), comma-separated. They work on every
# plugin route, but their creation catalog / kit skin / masked template pushes are ignored,
# so only the PLUGIN_KEY server decides what the website character creator shows.
# PLUGIN_KEYS_SECONDARY=
STAFF_KEY=dev-staff-key
MINESKIN_API_KEY=
# Precedent lookup (/precedent) — Supabase Postgres + Voyage embeddings + Claude
SUPABASE_DB_URL=
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=

# Patreon v2: enable sync first in shadow mode, then enable appliers after review.
PATREON_ENABLED=0
PATREON_APPLY=0
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_CREATOR_ACCESS_TOKEN=
PATREON_CREATOR_REFRESH_TOKEN=
PATREON_WEBHOOK_SECRET=
PATREON_API_BASE=https://www.patreon.com
# PATREON_CAMPAIGN_ID=13707169
PATREON_REDIRECT_URI=https://www.tfminecraft.net/api/patreon/oauth/callback
PATREON_PUBLIC_SITE_URL=https://www.tfminecraft.net
PATREON_SYNC_INTERVAL_SECONDS=600
PATREON_DECLINED_GRACE_DAYS=7
PATREON_RELINK_COOLDOWN_DAYS=30
PATREON_MASS_REMOVAL_FRACTION=0.25
# 1 during the one-time migration: role changes still enqueue, but Discord DMs stay null.
# Acknowledging those changes marks the DM delivered so it is not sent after this is set back to 0.
PATREON_SUPPRESS_DMS=0

# Discord sign-in (website accounts). Uses the bot's Discord application:
# add DISCORD_REDIRECT_URI as an OAuth2 redirect there. DISCORD_GUILD_ID is the
# TFMC server; linking Minecraft requires current membership.
DISCORD_AUTH_ENABLED=0
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Defaults to SITE_PUBLIC_URL + /api/auth/discord/callback; must be on the site host.
# DISCORD_REDIRECT_URI=
SITE_PUBLIC_URL=https://www.tfminecraft.net
