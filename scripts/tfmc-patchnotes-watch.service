# Notes changed files in Main's plugin folders. Started by tfmc-patchnotes-watch.timer;
# install with tfmc-patchnotes-rewrite.service.
[Unit]
Description=TFMC patch notes: scan Main's plugin folders
After=network-online.target docker.service

[Service]
Type=oneshot
# STAFF_KEY, and API_BASE_URL when the API is not on 127.0.0.1:8000.
EnvironmentFile=/etc/tfmc/patchnotes.env
Environment=PYTHONPATH=/usr/local/lib/tfmc-patchnotes/current
Environment=PATCHNOTES_PLUGINS_DIR=/home/amp/.ampdata/instances/TFMCMain01/Minecraft/plugins
Environment=PATCHNOTES_PLUGINS_STATE=/var/lib/tfmc-patchnotes/plugin-patchnotes.json
WorkingDirectory=/
ExecStart=/usr/bin/python3 -B -m patchnotes.watch_plugins --once
Nice=10
IOSchedulingClass=idle

# A throwaway user that sees only the plugin folders, read-only. Some plugin files
# are amp's and mode 600, so it may read any file it can see.
DynamicUser=yes
StateDirectory=tfmc-patchnotes
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
BindReadOnlyPaths=/home/amp/.ampdata/instances/TFMCMain01/Minecraft/plugins
InaccessiblePaths=-/etc/shadow -/etc/gshadow -/etc/sudoers -/etc/sudoers.d -/etc/ssh -/etc/tfmc -/etc/letsencrypt -/run/docker.sock -/run/containerd -/var/lib/docker -/var/backups -/var/log -/opt -/srv -/mnt -/media
