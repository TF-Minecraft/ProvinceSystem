# Runs patch note rewrites through the Codex CLI on the host.
#   install -m 600 /dev/null /etc/tfmc/patchnotes.env   then set STAFF_KEY=... in it
#   install -m 755 scripts/patchnotes-update.py /usr/local/sbin/tfmc-patchnotes-update
#   cp scripts/tfmc-patchnotes-*.service scripts/tfmc-patchnotes-*.timer /etc/systemd/system/
#   systemctl daemon-reload && tfmc-patchnotes-update <commit on main>
#   systemctl enable --now tfmc-patchnotes-rewrite tfmc-patchnotes-watch.timer tfmc-patchnotes-weekly.timer
[Unit]
Description=TFMC patch note rewrite worker
After=network-online.target docker.service

[Service]
Type=simple
# STAFF_KEY, and API_BASE_URL when the API is not on 127.0.0.1:8000.
EnvironmentFile=/etc/tfmc/patchnotes.env
Environment=HOME=/root
Environment=PYTHONPATH=/usr/local/lib/tfmc-patchnotes/current
Environment=PATCHNOTES_CODEX_BIN=/root/.npm-global/bin/codex
Environment=PATH=/root/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/
ExecStart=/usr/bin/python3 -B -m patchnotes.rewrite_worker
Restart=always
RestartSec=5

# The model reads commit subjects, which are untrusted text. The Codex login
# belongs to root, so the service stays root, but it runs the root-owned copy
# that tfmc-patchnotes-update installs, sees an empty /home and /root apart from
# the CLI and its login, and cannot reach Docker.
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
TemporaryFileSystem=/home:ro /root:ro /etc/tfmc:ro
BindReadOnlyPaths=/root/.npm-global
BindPaths=/root/.codex
InaccessiblePaths=-/run/docker.sock -/run/containerd -/var/lib/docker -/var/lib/tfmc -/var/log -/opt -/srv -/mnt -/media

[Install]
WantedBy=multi-user.target
