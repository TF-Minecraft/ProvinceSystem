# Context = ProvinceSystem root (frontend + backend Dockerfiles)
.git
**/.git
**/node_modules
**/.next
**/__pycache__
**/*.pyc
**/.venv
**/venv
frontend/dist
frontend/build
*.md
# At any depth: backend/.env holds the site's secrets and must not be baked into an image.
**/.env
**/.env.*
!**/.env.example

# Generated map output and the local SQLite DB. `backend/Dockerfile` does
# `COPY backend/ .`, so without these a build bakes whatever happens to be in
# the working tree into the image — including seeded/spoof ledger history.
backend/src/output
backend/src/data/*.db
backend/src/data/*.db-wal
backend/src/data/*.db-shm
**/*.bak.*

# Test-data generators must never reach a production image.
backend/src/scripts/tools/generate_spoof_*.py

# Built inside the image from the pinned Mojang jar instead.
backend/src/coreprotect/data

# Private deployment state and retained offline copies never enter an image.
backend/src/data/migration-rollback
backend/src/data/postgres-migrations
backend/src/data/.postgres-*.json
backend/src/data/.postgres-*.part
backend/src/data/.province.rollback.part
