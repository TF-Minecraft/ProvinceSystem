# Sends a closed week's comparison of two Main backups. Started by
# tfmc-patchnotes-weekly.timer; install with tfmc-patchnotes-rewrite.service.
[Unit]
Description=TFMC patch notes: send the closed week's comparison
After=network-online.target docker.service

[Service]
Type=oneshot
# Reading two backups takes minutes; systemd's default 90 s is too short.
TimeoutStartSec=30min
# STAFF_KEY, and API_BASE_URL when the API is not on 127.0.0.1:8000.
EnvironmentFile=/etc/tfmc/patchnotes.env
Environment=PYTHONPATH=/usr/local/lib/tfmc-patchnotes/current
Environment=PATCHNOTES_BACKUPS_DIR=/home/amp/.ampdata/instances/TFMCMain01/Backups
WorkingDirectory=/
ExecStart=/usr/bin/python3 -B -m patchnotes.weekly_run
Nice=10
IOSchedulingClass=idle

# A throwaway user that sees only Main's backups, read-only.
DynamicUser=yes
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
BindReadOnlyPaths=/home/amp/.ampdata/instances/TFMCMain01/Backups
InaccessiblePaths=-/etc/tfmc -/run/docker.sock -/run/containerd -/var/lib/docker
